# Credenciales del panel admin (Team Rayo)
# Si no se definen, se usan los valores por defecto de src/features/admin/auth.ts
#
# VITE_ADMIN_USER: nombre de usuario del admin
# VITE_ADMIN_PASSWORD_HASH: hash SHA-256 (hex) de la contraseña.
#   Generar: node -e "crypto.createHash('sha256').update('TU-CONTRASEÑA').digest('hex')"
VITE_ADMIN_USER=admin
VITE_ADMIN_PASSWORD=Admin123*