Table gyms {
  id uuid [pk, note: 'Identificador único del gimnasio.']
  name varchar [not null, note: 'Nombre del gimnasio.']
  slug varchar [not null, unique, note: 'Identificador legible utilizado para identificar públicamente al gimnasio.']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Note: 'Gimnasio al que pertenecen los profesores, alumnos, planes, categorías, horarios y eventos.'
}

Table professors {
  id uuid [pk, note: 'Identificador único del profesor.']
  gym_id uuid [not null, ref: > gyms.id, note: 'Gimnasio al que pertenece el profesor.']
  name varchar [not null, note: 'Nombre del profesor.']
  email varchar [not null, unique, note: 'Correo utilizado para autenticarse en el panel de administración.']
  password varchar [not null, note: 'Contraseña almacenada de forma segura mediante un hash.']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    gym_id
  }

  Note: 'Profesor con acceso al panel de administración del gimnasio.'
}

Table students {
  id uuid [pk, note: 'Identificador único del alumno.']
  gym_id uuid [not null, ref: > gyms.id, note: 'Gimnasio al que pertenece el alumno.']
  plan_id uuid [not null, ref: > plans.id, note: 'Plan actual del alumno.']
  category_id uuid [not null, ref: > categories.id, note: 'Categoría actual del alumno.']
  
  first_name varchar [not null, note: 'Nombre del alumno.']
  last_name varchar [not null, note: 'Apellido del alumno.']
  dni varchar [not null, note: 'Documento Nacional de Identidad del alumno.']
  birth_date date [not null, note: 'Fecha de nacimiento del alumno.']
  phone varchar [not null, note: 'Número de teléfono del alumno.']
  admission_date date [not null, note: 'Fecha en la que el alumno ingresó al gimnasio.']
  current_weight decimal [not null, note: 'Peso actual del alumno.']
  competition_photo varchar [note: 'Referencia a la foto utilizada para representar al alumno en competencias.']
  
  active boolean [not null, note: 'Indica si el alumno se encuentra activo. Permite conservar el historial de alumnos que dejaron el gimnasio.']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    gym_id
    plan_id
    category_id
    (gym_id, dni) [unique]
  }

  Note: 'Alumno registrado en el gimnasio. Los alumnos no tienen acceso al sistema.'
}

Table weight_records {
  id uuid [pk, note: 'Identificador único del registro de peso.']
  student_id uuid [not null, ref: > students.id, note: 'Alumno al que corresponde el registro.']
  
  weight decimal [not null, note: 'Peso registrado del alumno.']
  date date [not null, note: 'Fecha en la que se registró el peso.']
  
  created_at timestamp [not null]

  indexes {
    student_id
    (student_id, date)
  }

  Note: 'Historial de peso de un alumno. Permite consultar la evolución del peso a lo largo del tiempo.'
}

Table categories {
  id uuid [pk, note: 'Identificador único de la categoría.']
  gym_id uuid [not null, ref: > gyms.id, note: 'Gimnasio al que pertenece la categoría.']
  name varchar [not null, note: 'Nombre de la categoría.']
  active boolean [not null, note: 'Indica si la categoría está disponible para asignarse a alumnos.']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    gym_id
    (gym_id, name) [unique]
  }

  Note: 'Categoría utilizada para clasificar a los alumnos. Las categorías son configurables por gimnasio.'
}

Table plans {
  id uuid [pk, note: 'Identificador único del plan.']
  gym_id uuid [not null, ref: > gyms.id, note: 'Gimnasio al que pertenece el plan.']
  
  name varchar [not null, note: 'Nombre del plan.']
  price decimal [not null, note: 'Precio mensual del plan.']
  active boolean [not null, note: 'Indica si el plan está disponible para nuevos alumnos.']
  
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    gym_id
    (gym_id, name) [unique]
  }

  Note: 'Plan mensual ofrecido por el gimnasio. Por ejemplo, Recreativo o Competitivo.'
}

Table payments {
  id uuid [pk, note: 'Identificador único del pago.']
  plan_id uuid [not null, ref: > plans.id, note: 'Plan correspondiente al período abonado. Permite conservar el historial del plan utilizado en cada pago.']
  student_id uuid [not null, ref: > students.id, note: 'Alumno que realizó el pago.']
  
  year int [not null, note: 'Año correspondiente al período abonado.']
  month int [not null, note: 'Mes correspondiente al período abonado.']
  amount decimal [not null, note: 'Monto abonado.']
  
  paid_at timestamp [not null, note: 'Fecha y hora en la que se registró el pago.']
  created_at timestamp [not null]

  indexes {
    student_id
    plan_id
    (student_id, year, month) [unique]
  }

  Note: 'Pago mensual realizado por un alumno. Permite consultar el estado y el historial de cuotas.'
}

Table schedules {
  id uuid [pk, note: 'Identificador único del horario.']
  gym_id uuid [not null, ref: > gyms.id, note: 'Gimnasio al que pertenece el horario.']
  
  name varchar [not null, note: 'Nombre de la actividad o clase.']
  day_of_week int [not null, note: 'Día de la semana en el que se realiza el entrenamiento.']
  start_time time [not null, note: 'Hora de inicio del entrenamiento.']
  end_time time [not null, note: 'Hora de finalización del entrenamiento.']
  
  active boolean [not null, note: 'Indica si el horario se encuentra disponible y visible.']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    gym_id
    (gym_id, day_of_week)
  }

  Note: 'Horario habitual de entrenamiento del gimnasio. Puede ser utilizado por la administración y la landing pública.'
}

Table attendances {
  id uuid [pk, note: 'Identificador único del registro de asistencia.']
  student_id uuid [not null, ref: > students.id, note: 'Alumno al que corresponde la asistencia.']
  schedule_id uuid [not null, ref: > schedules.id, note: 'Horario en el que se registró la asistencia.']
  
  date date [not null, note: 'Fecha del entrenamiento.']
  present boolean [not null, note: 'Indica si el alumno estuvo presente en el entrenamiento.']
  
  created_at timestamp [not null]

  indexes {
    student_id
    schedule_id
    (student_id, schedule_id, date) [unique]
    (schedule_id, date)
  }

  Note: 'Registro de asistencia de un alumno en un horario y fecha determinados.'
}

Table belt_exams {
  id uuid [pk, note: 'Identificador único del examen de cinturón.']
  student_id uuid [not null, ref: > students.id, note: 'Alumno que realizó el examen.']
  
  belt varchar [not null, note: 'Cinturón obtenido en el examen.']
  score decimal [not null, note: 'Puntuación obtenida en el examen.']
  date date [not null, note: 'Fecha en la que se realizó el examen.']
  
  created_at timestamp [not null]

  indexes {
    student_id
    (student_id, date)
  }

  Note: 'Historial de exámenes y graduaciones de cinturón de un alumno.'
}

Table events {
  id uuid [pk, note: 'Identificador único del evento.']
  gym_id uuid [not null, ref: > gyms.id, note: 'Gimnasio que organiza o registra el evento.']
  
  name varchar [not null, note: 'Nombre del evento.']
  type event_type [not null, note: 'Tipo de evento.']
  description text [note: 'Descripción del evento.']
  date date [not null, note: 'Fecha en la que se realizará o realizó el evento.']
  is_public boolean [not null, note: 'Indica si el evento puede mostrarse públicamente en la landing.']
  active boolean [not null, note: 'Indica si el evento se encuentra activo.']
  
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    gym_id
    (gym_id, date)
    (gym_id, type)
    (gym_id, is_public, date)
  }

  Note: 'Evento del gimnasio, como una competencia o exhibición. Puede publicarse en la landing.'
}

Enum event_type {
  competition
  exhibition
}

Table event_participants {
  id uuid [pk, note: 'Identificador único de la participación.']
  event_id uuid [not null, ref: > events.id, note: 'Evento en el que participa el alumno.']
  student_id uuid [not null, ref: > students.id, note: 'Alumno que participa en el evento.']
  
  weight decimal [note: 'Peso con el que el alumno participa en el evento.']
  
  created_at timestamp [not null]

  indexes {
    event_id
    student_id
    (event_id, student_id) [unique]
  }

  Note: 'Relación entre un alumno y un evento. Permite que un evento tenga múltiples participantes y que un alumno participe en múltiples eventos.'
}
Table fights {
  id uuid [pk, note: 'Identificador único de la pelea.']
  event_participant_id uuid [not null, ref: > event_participants.id, note: 'Participante al que pertenece la pelea.']
  opponent_name varchar [not null, note: 'Nombre del rival.']
  opponent_weight decimal [note: 'Peso del rival.']
  result fight_result [not null, note: 'Resultado obtenido en la pelea.']
  created_at timestamp [not null]

  indexes {
    event_participant_id
  }

  Note: 'Pelea realizada por un participante dentro de una competencia.'
}

Enum fight_result {
  win
  loss
  draw
}